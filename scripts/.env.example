# scripts/.env.example — the signing values build_macos.sh reads.
#
# Copy to scripts/.env (ignored by git) and replace the placeholders. The script
# reads these two keys from scripts/.env when the file exists; a variable already
# set in the environment wins over the file. No password belongs here: the
# app-specific password lives only inside the notarytool keychain profile.

CODESIGN_IDENTITY="Developer ID Application: YOUR NAME (YOURTEAMID)"
NOTARIZE_KEYCHAIN_PROFILE="your-notarytool-profile"
